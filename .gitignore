# macOS
.DS_Store

# Rails (from `rails new`, Rails 8.1.4)
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/storage/*
!/storage/.keep
/public/assets
/coverage/

# Secrets (never commit). config/credentials.yml.enc is committed; the key
# that opens it is not.
/config/*.key
/config/credentials/*.key
.env
.env.*

# Generated content database (bin/rails content:compile, BUILD.md P3.3)
/db/content*.sqlite3*

# Candidate files downloaded for rights research (D21); never served, never
# committed. content/SOURCES.md records where each came from.
/research/

# The deployed commit, written into each release by bin/deploy (P5.2).
/REVISION
