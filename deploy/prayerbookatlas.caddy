# Installed by deploy/cutover.sh as /etc/caddy/sites/prayerbookatlas.caddy and
# loaded by the server's main Caddyfile (`import /etc/caddy/sites/*.caddy`).
# Rails sends HSTS, the Content Security Policy, and the other security
# headers itself (docs/deploy.md), so they are not repeated here.
prayerbookatlas.com {
	encode zstd gzip
	header -Server

	@hidden path_regexp hidden (^|/)\.
	handle @hidden {
		respond 404
	}

	# Fingerprinted assets straight from the release; Rails serves everything else.
	handle /assets/* {
		root * /srv/www/prayerbookatlas.com/current/public
		header {
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options nosniff
		}
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:4315
	}

	log {
		output file /var/log/caddy/prayerbookatlas-access.log {
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 168h
		}
	}
}

# Every other name redirects permanently to the canonical one, keeping the path
# (BUILD.md D12). To serve the backup domain directly, see docs/deploy.md §5.
www.prayerbookatlas.com, prayerbook-atlas.com, www.prayerbook-atlas.com, prayerbookatlas.org, www.prayerbookatlas.org {
	header -Server
	redir https://prayerbookatlas.com{uri} 308
}
