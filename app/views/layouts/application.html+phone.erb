<!DOCTYPE html>
<html <%= tag.attributes(lang: "en", data: { appearance: (appearance unless appearance == "automatic"), **reading_settings.html_data }) %>>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body <%= tag.attributes(class: "site site--phone", data: { site_mode: "phone", controller: ("wake-lock" if reading_settings[:keep_awake] == "yes") }) %>>
    <a class="skip-link" href="#main"><%= t("site.skip_link") %></a>
    <%= render "shared/development_notice" %>

    <header class="phone-bar">
      <%= render "shared/wordmark" %>
      <nav class="phone-bar-tools" aria-label="<%= t("site.tools") %>">
        <%= link_to t("site.search"), search_path, aria: { current: ("page" if current_page?(search_path)) } %>
        <%= link_to t("site.settings"), settings_path, aria: { current: ("page" if current_page?(settings_path)) } %>
      </nav>
    </header>

    <main id="main" class="reading">
      <%= yield %>

      <% if content_for?(:margin) %>
        <details class="phone-margin">
          <summary><%= t("site.notes_and_sources") %></summary>
          <%= yield :margin %>
        </details>
      <% end %>
    </main>

    <%= render "shared/footer" %>

    <nav class="tab-bar" aria-label="<%= t("site.sections") %>">
      <ul>
        <% SiteSection.all.each do |section| %>
          <li><%= link_to section.title, section_path_for(section), aria: { current: ("page" if current_section?(section)) } %></li>
        <% end %>
      </ul>
    </nav>
  </body>
</html>
