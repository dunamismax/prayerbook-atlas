<% content_for :title, @title %>

<%= eyebrow(@section ? @section.title.downcase : t("site.name").downcase) %>
<h1><%= @title %></h1>
<%= title_rule %>

<div class="notice">
  <p><%= t(".not_built") %></p>
</div>

<%= plate_card t(".what_will_be_here"), label: t(".planned") do %>
  <p><%= @summary %></p>
  <p class="source"><%= t(".stays", phase: @phase) %></p>
<% end %>
