<footer class="site-footer">
  <nav aria-label="<%= t(".about_nav") %>">
    <ul>
      <li><%= link_to t(".about"), about_path %></li>
      <li><%= mail_to "support@prayerbookatlas.com" %></li>
    </ul>
  </nav>

  <p><%= t(".affiliation_html", link: link_to(t(".grace_and_footnotes"), "https://graceandfootnotes.com")) %></p>

  <div class="mode-line">
    <% if phone_site? %>
      <%= t(".using_phone") %>
      <%= render "shared/mode_switch", mode: "full", label: t(".use_full") %>
    <% else %>
      <%= t(".using_full") %>
      <%= render "shared/mode_switch", mode: "phone", label: t(".use_phone") %>
    <% end %>
    <% if site_mode_chosen? %>
      · <%= render "shared/mode_switch", mode: "automatic", label: t(".automatic") %>
    <% end %>
  </div>
</footer>
