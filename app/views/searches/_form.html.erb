<%= form_with url: search_path, method: :get, class: "search-form", html: { role: "search" } do |form| %>
  <%= form.label :q, t("searches.form.label"), for: field_id %>
  <%= form.search_field :q, value: search&.query, id: field_id, autocomplete: "off" %>
  <%= hidden_field_tag :book, search.book, id: nil if search&.book %>
  <%= hidden_field_tag :kind, search.kind, id: nil if search&.kind %>
  <%= form.button t("searches.form.button"), type: "submit", name: nil, class: "quiet-action" %>
<% end %>
