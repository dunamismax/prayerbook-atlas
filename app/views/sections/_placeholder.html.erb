<% content_for :title, @section.title unless @section.key == "today" %>

<%= eyebrow(@section.key == "today" ? t(".eyebrow_today") : t(".eyebrow_section")) %>
<h1><%= @section.title %></h1>
<%= title_rule %>

<%= yield :after_title %>

<p><%= @section.summary %></p>

<div class="notice">
  <p><%= t("site.not_ready") %></p>
</div>

<section class="plate-card" aria-labelledby="planned-<%= @section.key %>">
  <%= eyebrow t(".planned") %>
  <h2 id="planned-<%= @section.key %>"><%= t(".what_will_be_here") %></h2>
  <ul>
    <% t("sections.#{@section.key}.planned").each do |item| %>
      <li><%= item %></li>
    <% end %>
  </ul>
</section>
