<% content_for :title, t(".title") %>

<%= eyebrow t(".eyebrow") %>
<h1><%= t(".title") %></h1>
<%= title_rule %>

<p><%= t(".intro") %></p>

<%= plate_card t(".book.title"), label: t(".book.eyebrow") do %>
  <%= form_with url: book_preference_path, method: :patch, class: "settings-form" do |form| %>
    <%= render "settings/book_choices", form: form %>
    <%= form.button t(".book.save"), type: "submit", class: "primary-action", name: nil %>
  <% end %>
<% end %>

<%= plate_card t(".offices.title"), label: t(".offices.eyebrow") do %>
  <p><%= t(".offices.intro") %></p>
  <%= form_with url: book_preference_path, method: :patch, class: "settings-form" do |form| %>
    <% Office::SLUGS.each do |office| %>
      <div class="setting-row">
        <%= label_tag "office_books_#{office}", Office.name_for(office) %>
        <%= select_tag "office_books[#{office}]",
              options_for_select([ [ t(".offices.same", year: prayer_book.year), "same" ] ] + PrayerBook.all.map { [ _1.title, _1.id ] },
                office_book_overrides.fetch(office, "same")),
              id: "office_books_#{office}" %>
      </div>
    <% end %>
    <%= form.button t(".offices.save"), type: "submit", class: "primary-action", name: nil %>
  <% end %>
<% end %>

<%= plate_card t(".appearance.title"), label: t(".appearance.eyebrow") do %>
  <%# A full page load, not Turbo: Turbo swaps the body and keeps <html>, where the
      appearance is written. %>
  <%= form_with url: appearance_path, method: :patch, class: "settings-form", data: { turbo: false } do |form| %>
    <fieldset>
      <legend class="visually-hidden"><%= t(".appearance.title") %></legend>
      <% AppearancePreference::CHOICES.each do |value| %>
        <div class="choice">
          <%= form.radio_button :appearance, value, checked: appearance == value %>
          <%= form.label :appearance, t(".appearance.#{value}"), value: value %>
        </div>
      <% end %>
    </fieldset>
    <%= form.button t(".appearance.save"), type: "submit", class: "primary-action", name: nil %>
  <% end %>
<% end %>

<%= plate_card t(".reading.title"), label: t(".reading.eyebrow") do %>
  <%= liturgy SampleBlocks.all.values_at(1, 2, 4), heading_level: 3 %>

  <%= form_with url: reading_settings_path, method: :patch, class: "settings-form", data: { turbo: false } do |form| %>
    <% ReadingSettings::OPTIONS.each do |field, values| %>
      <%= render "settings/choices", form: form, field: field, legend: t(".reading.legends.#{field}"), current: reading_settings[field],
            choices: values.index_with { t(".reading.choices.#{field}.#{_1}") } %>
    <% end %>
    <p class="source"><%= t(".reading.spelling_note") %></p>
    <%= form.button t(".reading.save"), type: "submit", class: "primary-action", name: nil %>
  <% end %>
<% end %>

<%= plate_card t(".mode.title"), label: t(".mode.eyebrow") do %>
  <%= form_with url: site_mode_path, method: :patch, class: "settings-form" do |form| %>
    <fieldset>
      <legend class="visually-hidden"><%= t(".mode.title") %></legend>
      <% current = site_mode_chosen? ? site_mode : "automatic" %>
      <% %w[automatic full phone].each do |value| %>
        <div class="choice">
          <%= form.radio_button :mode, value, checked: current == value %>
          <%= form.label :mode, t(".mode.#{value}"), value: value %>
        </div>
      <% end %>
    </fieldset>
    <%= form.button t(".mode.save"), type: "submit", class: "primary-action", name: nil %>
  <% end %>
<% end %>

<%= plate_card t(".about.title"), label: t(".about.eyebrow") do %>
  <p><%= t(".about.affiliation_html", link: link_to(t("shared.footer.grace_and_footnotes"), "https://graceandfootnotes.com"), more: link_to(t(".about.more"), about_path)) %></p>
  <p><%= t(".about.support_html", email: mail_to("support@prayerbookatlas.com")) %></p>
  <h3 class="eyebrow"><%= t(".about.acknowledgements") %></h3>
  <ul class="acknowledgements">
    <% Content::Source.acknowledged.each do |source| %>
      <li><%= source.notice.presence || source.title %></li>
    <% end %>
  </ul>
  <p><%= t(".about.sources_html", link: link_to(t(".about.sources_link"), sources_path)) %></p>
  <p class="source"><%= t(".about.version", version: SiteVersion.current) %></p>
<% end %>
